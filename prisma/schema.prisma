generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id             BigInt    @id @default(autoincrement())
  nama           String    @db.VarChar(100)
  keterangan     String?   @db.VarChar(255)
  dibuat_oleh    String?   @db.VarChar(100)
  dibuat_tanggal DateTime  @default(now()) @db.DateTime(0)
  diubah_oleh    String?   @db.VarChar(100)
  diubah_tanggal DateTime? @db.DateTime(0)

  users User[]

  @@index([nama], map: "idx_role_nama")
  @@map("tb_role")
}

model Cabang {
  id             BigInt    @id @default(autoincrement())
  kode           String    @unique(map: "idx_cabang_kode") @db.VarChar(20)
  nama           String    @db.VarChar(150)
  alamat         String?   @db.Text
  telepon        String?   @db.VarChar(30)
  aktif          Int       @default(1) @db.TinyInt
  dibuat_oleh    String?   @db.VarChar(100)
  dibuat_tanggal DateTime  @default(now()) @db.DateTime(0)
  diubah_oleh    String?   @db.VarChar(100)
  diubah_tanggal DateTime? @db.DateTime(0)

  users         User[]
  harga_produks HargaProduk[]
  leads         Lead[]

  @@index([nama], map: "idx_cabang_nama")
  @@map("tb_cabang")
}

model User {
  id             BigInt    @id @default(autoincrement())
  cabang_id      BigInt
  role_id        BigInt
  nama           String    @db.VarChar(150)
  username       String    @unique(map: "idx_user_username") @db.VarChar(100)
  telepon        String    @unique(map: "idx_user_telepon") @db.VarChar(20)
  password       String    @db.VarChar(255)
  aktif          Int       @default(1) @db.TinyInt
  dibuat_oleh    String?   @db.VarChar(100)
  dibuat_tanggal DateTime  @default(now()) @db.DateTime(0)
  diubah_oleh    String?   @db.VarChar(100)
  diubah_tanggal DateTime? @db.DateTime(0)

  cabang     Cabang     @relation(fields: [cabang_id], references: [id])
  role       Role       @relation(fields: [role_id], references: [id])
  audit_logs AuditLog[]
  leads      Lead[]

  @@index([nama], map: "idx_user_nama")
  @@index([cabang_id], map: "idx_user_cabang")
  @@index([role_id], map: "idx_user_role")
  @@map("tb_user")
}

model AuditLog {
  id             BigInt   @id @default(autoincrement())
  user_id        BigInt?
  nama_user      String   @db.VarChar(150)
  modul          String   @db.VarChar(50)
  aksi           String   @db.VarChar(30)
  referensi_id   BigInt?
  deskripsi      String?  @db.Text
  data_sebelum   Json?
  data_sesudah   Json?
  ip_address     String?  @db.VarChar(45)
  user_agent     String?  @db.Text
  dibuat_tanggal DateTime @default(now()) @db.DateTime(0)

  user User? @relation(fields: [user_id], references: [id])

  @@index([user_id], map: "idx_audit_log_user")
  @@index([modul], map: "idx_audit_log_modul")
  @@index([aksi], map: "idx_audit_log_aksi")
  @@index([referensi_id], map: "idx_audit_log_referensi")
  @@index([dibuat_tanggal], map: "idx_audit_log_tanggal")
  @@map("tb_audit_log")
}

model KategoriProduk {
  id             BigInt    @id @default(autoincrement())
  kode           String    @unique(map: "idx_kategori_produk_kode") @db.VarChar(20)
  nama           String    @unique(map: "idx_kategori_produk_nama") @db.VarChar(100)
  aktif          Int       @default(1) @db.TinyInt
  dibuat_oleh    String?   @db.VarChar(100)
  dibuat_tanggal DateTime  @default(now()) @db.DateTime(0)
  diubah_oleh    String?   @db.VarChar(100)
  diubah_tanggal DateTime? @db.DateTime(0)

  produks Produk[]

  @@map("tb_kategori_produk")
}

model Produk {
  id                 BigInt    @id @default(autoincrement())
  kategori_produk_id BigInt
  kode               String    @unique(map: "idx_produk_kode") @db.VarChar(30)
  nama               String    @db.VarChar(200)
  satuan             String    @db.VarChar(30)
  harga_default      Decimal   @default(0) @db.Decimal(18, 2)
  aktif              Int       @default(1) @db.TinyInt
  dibuat_oleh        String?   @db.VarChar(100)
  dibuat_tanggal     DateTime  @default(now()) @db.DateTime(0)
  diubah_oleh        String?   @db.VarChar(100)
  diubah_tanggal     DateTime? @db.DateTime(0)

  kategori      KategoriProduk @relation(fields: [kategori_produk_id], references: [id])
  harga_cabangs HargaProduk[]
  detail_penawarans DetailPenawaran[]

  @@index([nama], map: "idx_produk_nama")
  @@index([kategori_produk_id], map: "idx_produk_kategori")
  @@map("tb_produk")
}

model HargaProduk {
  id             BigInt    @id @default(autoincrement())
  produk_id      BigInt
  cabang_id      BigInt
  harga          Decimal   @default(0) @db.Decimal(18, 2)
  dibuat_oleh    String?   @db.VarChar(100)
  dibuat_tanggal DateTime  @default(now()) @db.DateTime(0)
  diubah_oleh    String?   @db.VarChar(100)
  diubah_tanggal DateTime? @db.DateTime(0)

  produk Produk @relation(fields: [produk_id], references: [id])
  cabang Cabang @relation(fields: [cabang_id], references: [id])

  @@unique([produk_id, cabang_id], map: "idx_harga_produk_unique")
  @@index([produk_id], map: "idx_harga_produk_produk")
  @@index([cabang_id], map: "idx_harga_produk_cabang")
  @@map("tb_harga_produk")
}

model AlasanLost {
  id             BigInt    @id @default(autoincrement())
  kode           String    @unique(map: "idx_alasan_lost_kode") @db.VarChar(20)
  nama           String    @unique(map: "idx_alasan_lost_nama") @db.VarChar(150)
  aktif          Int       @default(1) @db.TinyInt
  dibuat_oleh    String?   @db.VarChar(100)
  dibuat_tanggal DateTime  @default(now()) @db.DateTime(0)
  diubah_oleh    String?   @db.VarChar(100)
  diubah_tanggal DateTime? @db.DateTime(0)

  @@map("tb_alasan_lost")
}

model Customer {
  id             BigInt    @id @default(autoincrement())
  nama           String    @db.VarChar(150)
  telepon        String    @db.VarChar(20)
  alamat         String?   @db.Text
  catatan        String?   @db.Text
  dibuat_oleh    String?   @db.VarChar(100)
  dibuat_tanggal DateTime  @default(now()) @db.DateTime(0)
  diubah_oleh    String?   @db.VarChar(100)
  diubah_tanggal DateTime? @db.DateTime(0)

  leads Lead[]

  @@index([nama], map: "idx_customer_nama")
  @@index([telepon], map: "idx_customer_telepon")
  @@map("tb_customer")
}

model HasilInteraksi {
  id             BigInt    @id @default(autoincrement())
  kode           String    @unique(map: "idx_hasil_interaksi_kode") @db.VarChar(30)
  nama           String    @unique(map: "idx_hasil_interaksi_nama") @db.VarChar(150)
  fase_lead      String    @db.VarChar(20) // LEAD_BARU, FOLLOW_UP, PENAWARAN
  urutan         Int       @default(0)
  warna          String?   @db.VarChar(20)
  ikon           String?   @db.VarChar(50)
  aktif          Int       @default(1) @db.TinyInt
  dibuat_oleh    String?   @db.VarChar(100)
  dibuat_tanggal DateTime  @default(now()) @db.DateTime(0)
  diubah_oleh    String?   @db.VarChar(100)
  diubah_tanggal DateTime? @db.DateTime(0)

  aktivitas_leads AktivitasLead[]

  @@index([fase_lead], map: "idx_hasil_interaksi_fase")
  @@index([aktif], map: "idx_hasil_interaksi_aktif")
  @@map("tb_hasil_interaksi")
}

model Lead {
  id                        BigInt    @id @default(autoincrement())
  nomor                     String    @unique(map: "uk_lead_nomor") @db.VarChar(30)
  customer_id               BigInt
  cabang_id                 BigInt
  user_id                   BigInt
  status_customer           String    @default("BARU") @db.VarChar(20) // BARU, EXISTING
  status                    Int       @default(1) @db.TinyInt // 1=OPEN, 2=DEAL, 3=LOST
  fase                      Int       @default(1) @db.TinyInt // 1=LEAD_BARU, 2=FOLLOW_UP, 3=PENAWARAN
  kebutuhan                 String?   @db.Text // JSON array of kategori_produk_id
  versi_penawaran_final_id  BigInt?
  nilai_deal                Decimal?  @db.Decimal(18, 2)
  tanggal_deal              DateTime? @db.DateTime(0)
  alasan_lost_id            BigInt?
  nama_alasan_lost          String?   @db.VarChar(200)
  nilai_lost                Decimal?  @db.Decimal(18, 2)
  catatan_awal              String?   @db.Text
  catatan_lost              String?   @db.Text
  tanggal_lost              DateTime? @db.DateTime(0)
  dibuat_oleh               String?   @db.VarChar(100)
  dibuat_tanggal            DateTime  @default(now()) @db.DateTime(0)
  diubah_oleh               String?   @db.VarChar(100)
  diubah_tanggal            DateTime? @db.DateTime(0)

  customer        Customer        @relation(fields: [customer_id], references: [id])
  cabang          Cabang          @relation(fields: [cabang_id], references: [id])
  user            User            @relation(fields: [user_id], references: [id])
  aktivitas_leads AktivitasLead[]
  pengingats      Pengingat[]
  versi_penawaran_final     VersiPenawaran? @relation("FinalPenawaran", fields: [versi_penawaran_final_id], references: [id])
  versi_penawarans          VersiPenawaran[] @relation("LeadVersiPenawarans")

  @@index([customer_id], map: "idx_lead_customer")
  @@index([cabang_id], map: "idx_lead_cabang")
  @@index([user_id], map: "idx_lead_user")
  @@index([status_customer], map: "idx_lead_status_customer")
  @@index([status], map: "idx_lead_status")
  @@index([fase], map: "idx_lead_fase")
  @@index([tanggal_deal], map: "idx_lead_tanggal_deal")
  @@index([tanggal_lost], map: "idx_lead_tanggal_lost")
  @@map("tb_lead")
}

model AktivitasLead {
  id                  BigInt    @id @default(autoincrement())
  lead_id             BigInt
  user_id             BigInt
  hasil_interaksi_id  BigInt
  hasil_interaksi     String    @db.VarChar(150) // Snapshot
  catatan             String?   @db.Text
  dibuat_oleh         String?   @db.VarChar(100)
  dibuat_tanggal      DateTime  @default(now()) @db.DateTime(0)
  diubah_oleh         String?   @db.VarChar(100)
  diubah_tanggal      DateTime? @db.DateTime(0)

  lead             Lead            @relation(fields: [lead_id], references: [id])
  hasil_interaksi_rel HasilInteraksi @relation(fields: [hasil_interaksi_id], references: [id])
  pengingat        Pengingat?

  @@index([lead_id], map: "idx_aktivitas_lead_lead")
  @@index([user_id], map: "idx_aktivitas_lead_user")
  @@index([hasil_interaksi_id], map: "idx_aktivitas_lead_hasil_interaksi")
  @@index([dibuat_tanggal], map: "idx_aktivitas_lead_tanggal")
  @@map("tb_aktivitas_lead")
}

model Pengingat {
  id                 BigInt    @id @default(autoincrement())
  lead_id            BigInt
  aktivitas_lead_id  BigInt    @unique
  tanggal_pengingat  DateTime  @db.DateTime(0)
  catatan            String?   @db.Text
  status             String    @default("AKTIF") @db.VarChar(10) // AKTIF, SELESAI
  dibuat_oleh        String?   @db.VarChar(100)
  dibuat_tanggal     DateTime  @default(now()) @db.DateTime(0)
  diubah_oleh        String?   @db.VarChar(100)
  diubah_tanggal     DateTime? @db.DateTime(0)

  lead          Lead          @relation(fields: [lead_id], references: [id])
  aktivitas_lead AktivitasLead @relation(fields: [aktivitas_lead_id], references: [id])

  @@index([lead_id], map: "idx_pengingat_lead")
  @@index([status], map: "idx_pengingat_status")
  @@index([tanggal_pengingat], map: "idx_pengingat_tanggal")
  @@map("tb_pengingat")
}

model VersiPenawaran {
  id               BigInt    @id @default(autoincrement())
  nomor            String    @db.VarChar(30)
  lead_id          BigInt
  versi            Int       @default(1)
  customer_nama    String    @db.VarChar(200)
  customer_telepon String?   @db.VarChar(30)
  customer_alamat  String?   @db.Text
  sales_nama       String    @db.VarChar(150)
  cabang_nama      String    @db.VarChar(150)
  catatan          String?   @db.Text
  masa_berlaku     Int       @default(30)
  subtotal         Decimal   @default(0) @db.Decimal(18, 2)
  diskon_persen    Decimal   @default(0) @db.Decimal(5, 2)
  diskon_nominal   Decimal   @default(0) @db.Decimal(18, 2)
  ppn_persen       Decimal   @default(11) @db.Decimal(5, 2)
  ppn_nominal      Decimal   @default(0) @db.Decimal(18, 2)
  grand_total      Decimal   @default(0) @db.Decimal(18, 2)
  dp_persen        Decimal   @default(0) @db.Decimal(5, 2)
  dp_nominal       Decimal   @default(0) @db.Decimal(18, 2)
  dibuat_oleh      String?   @db.VarChar(100)
  dibuat_tanggal   DateTime  @default(now()) @db.DateTime(0)
  diubah_oleh      String?   @db.VarChar(100)
  diubah_tanggal   DateTime? @db.DateTime(0)

  lead             Lead              @relation("LeadVersiPenawarans", fields: [lead_id], references: [id])
  details          DetailPenawaran[]
  final_leads      Lead[]            @relation("FinalPenawaran")

  @@unique([lead_id, versi], map: "idx_versi_penawaran_unique")
  @@index([lead_id], map: "idx_versi_penawaran_lead")
  @@index([nomor], map: "idx_versi_penawaran_nomor")
  @@index([versi], map: "idx_versi_penawaran_versi")
  @@index([dibuat_tanggal], map: "idx_versi_penawaran_tanggal")
  @@map("tb_versi_penawaran")
}

model DetailPenawaran {
  id                   BigInt   @id @default(autoincrement())
  versi_penawaran_id   BigInt
  produk_id            BigInt
  kategori_produk_nama String   @db.VarChar(100)
  kode_produk          String   @db.VarChar(50)
  nama_produk          String   @db.VarChar(200)
  satuan               String   @db.VarChar(30)
  qty                  Decimal  @default(1) @db.Decimal(18, 2)
  harga                Decimal  @default(0) @db.Decimal(18, 2)
  diskon_persen        Decimal  @default(0) @db.Decimal(5, 2)
  diskon_nominal       Decimal  @default(0) @db.Decimal(18, 2)
  subtotal             Decimal  @default(0) @db.Decimal(18, 2)
  dibuat_oleh          String?  @db.VarChar(100)
  dibuat_tanggal      DateTime @default(now()) @db.DateTime(0)
  diubah_oleh          String?  @db.VarChar(100)
  diubah_tanggal       DateTime? @db.DateTime(0)

  versi_penawaran      VersiPenawaran @relation(fields: [versi_penawaran_id], references: [id], onDelete: Cascade)
  produk               Produk         @relation(fields: [produk_id], references: [id])

  @@index([versi_penawaran_id], map: "idx_detail_penawaran_versi")
  @@index([produk_id], map: "idx_detail_penawaran_produk")
  @@map("tb_detail_penawaran")
}
